+            </child>
+            <child>
+              <object class="GtkShortcutsShortcut">
+                <property name="accelerator">Page_Up</property>
+                <property name="title" translatable="yes">Seek forward 10 minutes</property>
+              </object>
+            </child>
+            <child>
+              <object class="GtkShortcutsShortcut">
+                <property name="accelerator">Page_Down</property>
+                <property name="title" translatable="yes">Seek backward 10 minutes</property>
               </object>
             </child>
             <child>
@@ -316,13 +340,13 @@ audio-volume-medium-symbolic</property>
             </child>
             <child>
